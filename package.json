{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply burgerbaz-menu --local",
    "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute burgerbaz-menu --local --file=seed.sql",
    "setup:local": "node scripts/init-local.mjs && npm run db:migrate:local && npm run db:seed:local",
    "dev:sandbox": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "test:api": "node tests/api.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:serving": "node tests/serving.mjs"
  },
  "overrides": {"undici": "7.30.1"},
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
